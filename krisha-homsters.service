[Unit]
Description=Hatuli Homsters.kz Enrichment (primary market ЖК data)
After=network.target postgresql.service

[Service]
Type=simple
User=nik
WorkingDirectory=/home/nik/krisha_bot
ExecStart=/home/nik/krisha_bot/venv/bin/python service_homsters.py
Restart=always
RestartSec=60
TimeoutStopSec=15
KillSignal=SIGKILL
StandardOutput=append:/home/nik/krisha_bot/homsters.log
StandardError=append:/home/nik/krisha_bot/homsters.log

[Install]
WantedBy=multi-user.target
