[Unit]
Description=Hatuli Market Data (NBRK rate, KDIF deposits, stat.gov.kz housing index)
After=network.target postgresql.service

[Service]
Type=simple
User=nik
WorkingDirectory=/home/nik/krisha_bot
ExecStart=/home/nik/krisha_bot/venv/bin/python service_market_data.py
Restart=always
RestartSec=120
TimeoutStopSec=15
KillSignal=SIGKILL
StandardOutput=append:/home/nik/krisha_bot/market.log
StandardError=append:/home/nik/krisha_bot/market.log

[Install]
WantedBy=multi-user.target
