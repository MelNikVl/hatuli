# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_ID=123456789

# PostgreSQL (PRIMARY database)
# Создай БД: createdb -U postgres krisha_bot
# Создай юзера: createuser -U postgres -P krisha
DATABASE_URL=postgresql://krisha:password@localhost/krisha_bot

# SQLite (оставить для compat-слоя admin web на время перехода)
DB_PATH=bot.db

# AI
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Парсер продаж: 0 = выключен (для тестирования rental парсера)
PARSER_ENABLED=0

# Admin web
ADMIN_PASSWORD=change_me

# Parser defaults
CITY=astana
DEAL_TYPE=rent
MAX_PRICE=200000
MIN_ROOMS=1
MAX_ROOMS=4

BOT_VERSION=2.0.0
