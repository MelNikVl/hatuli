+// Мини-график истории цены (SVG) — подгружается при открытии попапа
+function sparklineSVG(points, w, h) {
+  if (points.length === 0) return '';
+  const prices = points.map(p => p.price);
+  const mn = Math.min(...prices), mx = Math.max(...prices);
+  const span = mx - mn || 1;
+  const stepX = points.length > 1 ? w / (points.length - 1) : 0;
+  const coords = points.map((p, i) => [i * stepX, h - ((p.price - mn) / span) * (h - 6) - 3]);
+  const path = coords.map((c, i) => (i ? 'L' : 'M') + c[0].toFixed(1) + ',' + c[1].toFixed(1)).join(' ');
+  const dots = coords.map(c => `<circle cx="${c[0].toFixed(1)}" cy="${c[1].toFixed(1)}" r="2.4" fill="#2563eb"/>`).join('');
+  return `<svg width="${w}" height="${h}" style="display:block;">` +
+         `<path d="${path}" fill="none" stroke="#2563eb" stroke-width="1.6"/>${dots}</svg>`;
