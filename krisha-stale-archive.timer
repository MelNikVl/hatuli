[Unit]
Description=Таймер архивации/реактивации объявлений по last_seen (каждые 3 ч)

[Timer]
# Каждые 3 часа: реактивация «снова в выдаче» должна быть быстрой; архивация идемпотентна.
OnCalendar=*-*-* 01,04,07,10,13,16,19,22:50:00
RandomizedDelaySec=5m
Persistent=true
Unit=krisha-stale-archive.service

[Install]
WantedBy=timers.target
