[Unit]
Description=Ежедневный снимок Deal Score (deal_score_snapshots) — Фаза A.5 п.2-3 вердикт-стратегии, задача 2026-08-14
After=network.target postgresql.service krisha-listing-snapshot.service krisha-apartments.service

[Service]
Type=oneshot
User=nik
WorkingDirectory=/home/nik/krisha_bot
ExecStart=/home/nik/krisha_bot/venv/bin/python /home/nik/krisha_bot/deal_score_snapshot.py
StandardOutput=append:/home/nik/krisha_bot/deal_score_snapshot.log
StandardError=append:/home/nik/krisha_bot/deal_score_snapshot.log
