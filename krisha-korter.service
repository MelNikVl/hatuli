[Unit]
Description=Hatuli Korter.kz Enrichment (housing class, developer)
After=network.target postgresql.service

[Service]
Type=simple
User=nik
WorkingDirectory=/home/nik/krisha_bot
ExecStart=/home/nik/krisha_bot/venv/bin/python service_korter.py
Restart=always
RestartSec=60
TimeoutStopSec=15
KillSignal=SIGKILL
StandardOutput=append:/home/nik/krisha_bot/korter.log
StandardError=append:/home/nik/krisha_bot/korter.log

[Install]
WantedBy=multi-user.target
