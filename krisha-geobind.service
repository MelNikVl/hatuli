[Unit]
Description=Hatuli Geobind (привязка объявлений к ЖК/адресу/координатам)
After=network.target postgresql.service

[Service]
Type=simple
User=nik
WorkingDirectory=/home/nik/krisha_bot
ExecStart=/home/nik/krisha_bot/venv/bin/python service_geobind.py
Restart=always
RestartSec=120
TimeoutStopSec=15
KillSignal=SIGKILL
StandardOutput=append:/home/nik/krisha_bot/geobind.log
StandardError=append:/home/nik/krisha_bot/geobind.log

[Install]
WantedBy=multi-user.target
