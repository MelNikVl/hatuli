[Unit]
Description=Ежедневный прогноз ликвидности (liquidity_predictions) — Фаза D вердикт-стратегии, задача 2026-10-02
After=network.target postgresql.service krisha-listing-snapshot.service krisha-deal-score-snapshot.service

[Service]
Type=oneshot
User=nik
WorkingDirectory=/home/nik/krisha_bot
ExecStart=/home/nik/krisha_bot/venv/bin/python /home/nik/krisha_bot/liquidity_predict.py
StandardOutput=append:/home/nik/krisha_bot/liquidity_predict.log
StandardError=append:/home/nik/krisha_bot/liquidity_predict.log
