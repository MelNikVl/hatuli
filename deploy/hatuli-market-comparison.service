[Unit]
Description=Hatuli primary and secondary market comparison snapshot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=nik
WorkingDirectory=/home/nik/krisha_bot
ExecStart=/home/nik/krisha_bot/venv/bin/python scripts/publish_market_comparison.py
TimeoutStartSec=3min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/nik/krisha_bot/var
