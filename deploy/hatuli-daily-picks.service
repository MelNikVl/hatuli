[Unit]
Description=Hatuli daily public apartment selection
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=nik
WorkingDirectory=/home/nik/krisha_bot
Environment=HATULI_DAILY_PICKS_PATH=/home/nik/krisha_bot/var/daily-picks.json
ExecStart=/home/nik/krisha_bot/venv/bin/python scripts/publish_daily_picks.py
TimeoutStartSec=8min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/nik/krisha_bot/var
